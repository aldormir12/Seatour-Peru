# Copiar a .env. No incluir credenciales reales en Git.
SEATOUR_PORT=8088
SPRING_DATASOURCE_PASSWORD=
# Base64 de al menos 32 bytes aleatorios; usar el secreto existente o generar uno.
SEATOUR_JWT_SECRET=

# Opcional: inicialización del ADMIN de una base vacía. Definir ambas o ninguna.
# SEATOUR_ADMIN_EMAIL=
# SEATOUR_ADMIN_PASSWORD=

# Opcional: LiveKit debe ser accesible desde el navegador del usuario.
# LIVEKIT_URL=wss://tu-servidor-livekit
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# Opcional: SMTP. localhost dentro del contenedor es el propio contenedor.
# SEATOUR_CORREO_HABILITADO=true
# SEATOUR_CORREO_REMITENTE=
# SEATOUR_SMTP_HOST=
# SEATOUR_SMTP_PORT=587
# SEATOUR_SMTP_USUARIO=
# SEATOUR_SMTP_PASSWORD=
